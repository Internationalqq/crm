# Copy to .env.docker or use these values in your shell before docker compose up.
# docker compose reads a file named .env automatically; do not commit real passwords.

PMBI_ADMIN_PASSWORD=change-me
PMBI_PUBLIC_BASE_URL=http://127.0.0.1:8080
PMBI_CRM_PUBLIC_URL=
PMBI_CRM_LOGIN=admin
PMBI_CRM_PASSWORD=change-me
PMBI_CRM_MAX_MATERIALS=2000
PMBI_SMTP_HOST=
PMBI_SMTP_PORT=587
PMBI_SMTP_USERNAME=
PMBI_SMTP_PASSWORD=
PMBI_SMTP_FROM=
PMBI_SMTP_USE_TLS=1
PMBI_SMTP_USE_SSL=0
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8080
CLERK_ADMIN_EMAILS=
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/dashboard

REPORT_SITE_PUBLIC_BASE_URL=http://127.0.0.1:8765
WEB_UI_PUBLIC_BASE_URL=http://127.0.0.1:8765
MARKET_AVITO_HEADLESS=1
SKIP_PERPLEXITY_TXT=1
RUN_MARKET=1
MARKET_MAX_ROWS=0
MARKET_PAUSE_SEC=18
MARKET_SOURCES=avito,web
MAIN_MAX_PAGES=2
MAIN_MAX_TENDERS=15
MAIN_DAYS_BACK=60

# Optional Telegram notifications for AutoBot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SPOOL_ON_FAIL=1
