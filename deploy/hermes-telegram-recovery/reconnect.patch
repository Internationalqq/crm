+@pytest.mark.asyncio
+async def test_verified_reconnect_resets_budget():
+    adapter = _make_adapter()
+    adapter._app, _ = _make_mock_app()
+    adapter._app.bot.get_me = AsyncMock()
+    adapter._polling_network_error_count = 7
+    adapter._send_path_degraded = True
+    with patch("asyncio.sleep", new_callable=AsyncMock):
+        await adapter._verify_polling_after_reconnect()
+    assert adapter._polling_network_error_count == 0
+    assert not adapter._send_path_degraded
+
+
+@pytest.mark.asyncio
+async def test_simultaneous_reconnects_use_one_lane():
+    adapter = _make_adapter()
+    adapter._app, _ = _make_mock_app()
+    adapter._app.bot.get_me = AsyncMock()
+    entered, release = asyncio.Event(), asyncio.Event()
+    async def wait_delay(delay):
+        entered.set()
+        await release.wait()
+    with patch("asyncio.sleep", side_effect=wait_delay):
+        first = asyncio.create_task(adapter._handle_polling_network_error(Exception("offline")))
+        await entered.wait()
+        await adapter._handle_polling_network_error(Exception("same outage"))
+        assert adapter._polling_network_error_count == 1
+        release.set()
+        await first
+    adapter._app.updater.start_polling.assert_awaited_once()
+    adapter._polling_probe_task.cancel()
+    await asyncio.gather(adapter._polling_probe_task, return_exceptions=True)
+
+
+@pytest.mark.asyncio
+async def test_new_reconnect_cancels_previous_probe():
+    adapter = _make_adapter()
+    adapter._app, _ = _make_mock_app()
+    old = asyncio.create_task(asyncio.Event().wait())
+    adapter._polling_probe_task = old
+    with patch("asyncio.sleep", new_callable=AsyncMock):
+        await adapter._handle_polling_network_error(Exception("new outage"))
+    assert old.cancelled()
+    assert adapter._polling_probe_task is not old
+    adapter._polling_probe_task.cancel()
+    await asyncio.gather(adapter._polling_probe_task, return_exceptions=True)
+
+
