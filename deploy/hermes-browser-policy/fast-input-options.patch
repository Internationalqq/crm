--- /dev/null
+++ b/tests/computer_use/test_fast_input_options.py
@@ -0,0 +1,45 @@
+import json
+from unittest.mock import Mock
+import pytest
+from tools.computer_use.cua_backend import CuaDriverBackend
+from tools.computer_use.tool import _dispatch
+
+def backend():
+ b=CuaDriverBackend(allowed_apps=['Firefox'],keyboard_delivery_mode='foreground')
+ b._active_pid,b._active_window_id=11,42
+ b._session.call_tool=Mock(return_value={'isError':False,'data':{'effect':'unverifiable'}})
+ return b
+
+def test_zero_delay_reaches_same_target_once():
+ b=backend(); r=json.loads(_dispatch(b,'type',{'text':'Запрос','element':7,'delay_ms':0}))
+ assert r['ok'] and r['meta']['effect']=='unverifiable'
+ b._session.call_tool.assert_called_once()
+ name,args=b._session.call_tool.call_args.args
+ assert name=='type_text' and args['delay_ms']==0 and args['element_index']==7
+ assert (args['pid'],args['window_id'])==(11,42)
+
+@pytest.mark.parametrize('delay',[-1,201,1.5,True,'0'])
+def test_bad_delay_never_types(delay):
+ b=backend(); r=json.loads(_dispatch(b,'type',{'text':'x','delay_ms':delay}))
+ assert r.get('error') or r.get('ok') is False
+ b._session.call_tool.assert_not_called()
+
+def test_foreground_click_preserves_exact_window_and_token():
+ b=backend();b._snapshot_tokens={7:'test-token'};b._session.supports_capability=Mock(return_value=True)
+ r=json.loads(_dispatch(b,'click',{'element':7,'delivery_mode':'foreground'}))
+ assert r['ok'];b._session.call_tool.assert_called_once()
+ name,args=b._session.call_tool.call_args.args
+ assert name=='click' and args['delivery_mode']=='foreground'
+ assert (args['pid'],args['window_id'],args['element_token'])==(11,42,'test-token')
+
+@pytest.mark.parametrize('mode',['','auto',True,0])
+def test_invalid_click_mode_never_clicks(mode):
+ b=backend();r=json.loads(_dispatch(b,'click',{'element':7,'delivery_mode':mode}))
+ assert r.get('error') or r.get('ok') is False
+ b._session.call_tool.assert_not_called()
+
+def test_unspecified_options_preserve_defaults():
+ b=backend();_dispatch(b,'type',{'text':'x'})
+ assert 'delay_ms' not in b._session.call_tool.call_args.args[1]
+ b=backend();_dispatch(b,'click',{'element':7})
+ assert 'delivery_mode' not in b._session.call_tool.call_args.args[1]
