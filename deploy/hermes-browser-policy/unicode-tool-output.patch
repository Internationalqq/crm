+import json
+import pytest
+from tools.computer_use.backend import CaptureResult, UIElement
+from tools.computer_use.tool import _capture_response
+
+
+@pytest.mark.parametrize('label', ['Сообщения — отправлено', '商品 🧱', 'Кнопка "Отправить"\\u041a'])
+def test_ax_text_is_readable_and_json_round_trips(label):
+    cap = CaptureResult(mode='ax', width=1200, height=900, app='Firefox',
+                        window_title='Переписка',
+                        elements=[UIElement(index=1, role='AXButton', label=label)])
+    raw = _capture_response(cap)
+    assert 'Переписка' in raw
+    assert json.loads(raw)['elements'][0]['label'] == label
+
+
+def test_action_capture_keeps_unicode_without_reencoding():
+    from unittest.mock import MagicMock
+    from tools.computer_use.backend import ActionResult
+    from tools.computer_use.tool import _maybe_follow_capture
+    backend = MagicMock()
+    backend._last_app = 'Firefox'
+    backend.capture.return_value = CaptureResult(mode='ax', width=1200, height=900,
+        app='Firefox', window_title='Переписка', elements=[])
+    raw = _maybe_follow_capture(backend, ActionResult(ok=True, action='click', message='Нажато'), True, mode='ax')
+    assert 'Переписка' in raw and 'Нажато' in raw
+    assert json.loads(raw)['ok'] is True
