+def test_show_keeps_non_ascii_task_text_readable(worker_env):
+    from hermes_cli import kanban_db as kb
+    from tools import kanban_tools as kt
+    title = 'Габионы — запрос цены 🧱'
+    conn = kb.connect()
+    try:
+        tid = kb.create_task(conn, title=title, assignee='gulya')
+    finally:
+        conn.close()
+    raw = kt._handle_show({'task_id': tid})
+    assert title in raw
+    assert json.loads(raw)['task']['title'] == title
