+import asyncio
+from unittest.mock import AsyncMock, Mock
+
+import pytest
+
+from tools.computer_use.cua_backend import CuaDriverBackend, _AsyncBridge, _CuaDriverSession
+
+
+def ok(**structured):
+    return {'isError': False, 'data': '', 'structuredContent': structured}
+
+
+def ended(name='list_windows', session='owner'):
+    return {'isError': True, 'data': f"session '{session}' has ended; tool call '{name}' was rejected. Call start_session with this id to revive it before issuing further actions, or use a new session id."}
+
+
+def session(*results):
+    s = _CuaDriverSession(_AsyncBridge())
+    s._started = True
+    s._call_tool_async = AsyncMock(side_effect=results)
+    s._bridge.run = lambda coro, timeout: asyncio.run(coro)
+    s._restart_session_locked = Mock()
+    return s
+
+
+@pytest.mark.parametrize('name', ['list_windows', 'list_apps', 'get_window_state', 'screenshot'])
+def test_ended_observation_revives_only_own_session_once(name):
+    result = ok(windows=[])
+    s = session(ended(name), ok(), result)
+    assert s.call_tool(name, {'session': 'owner'}) == result
+    assert [c.args[0] for c in s._call_tool_async.call_args_list] == [name, 'start_session', name]
+    assert s._call_tool_async.call_args_list[1].args[1] == {'session': 'owner'}
+
+
+def test_revival_is_bounded():
+    s = session(ended(), ok(), ended())
+    assert s.call_tool('list_windows', {'session': 'owner'})['isError']
+    assert s._call_tool_async.call_count == 3
+
+
+def test_failed_revival_stops_without_retry():
+    denied = {'isError': True, 'data': 'permission denied'}
+    s = session(ended(), denied)
+    assert s.call_tool('list_windows', {'session': 'owner'}) == denied
+    assert s._call_tool_async.call_count == 2
+
+
+@pytest.mark.parametrize('result', [
+    {'isError': True, 'data': 'permission denied'},
+    ended(session='someone-else'),
+    {'isError': False, 'data': ended()['data']},
+])
+def test_permission_other_identity_and_page_text_do_not_trigger_revival(result):
+    s = session(result)
+    assert s.call_tool('list_windows', {'session': 'owner'}) == result
+    assert s._call_tool_async.call_count == 1
+
+
+@pytest.mark.parametrize('name', ['click', 'type_text', 'press_key'])
+def test_mutating_calls_never_replayed_when_session_ended(name):
+    s = session(ended(name))
+    assert s.call_tool(name, {'session': 'owner'})['isError']
+    assert s._call_tool_async.call_count == 1
+
+
+def test_interrupted_input_reconnects_but_never_replays_input():
+    s = session(BrokenPipeError())
+    out = s.call_tool('click', {'session': 'owner'})
+    assert out['isError'] and 'not replayed' in out['data']
+    s._restart_session_locked.assert_called_once()
+    assert s._call_tool_async.call_count == 1
+
+
+def test_interrupted_observation_recovers_transport_then_identity():
+    s = session(BrokenPipeError(), ended(), ok(), ok(windows=[]))
+    assert not s.call_tool('list_windows', {'session': 'owner'})['isError']
+    s._restart_session_locked.assert_called_once()
+    assert s._call_tool_async.call_count == 4
+
+
+@pytest.mark.parametrize('allowed,forbidden', [('Firefox', 'Safari'), ('Safari', 'Firefox')])
+def test_other_browser_and_desktop_blocked_before_reading(allowed, forbidden):
+    b = CuaDriverBackend(allowed_apps=[allowed])
+    b._session = Mock()
+    b._active_pid, b._active_window_id = 12, 34
+    for app in (forbidden, 'desktop', 'Fire', '/Applications/' + allowed + '.app'):
+        with pytest.raises(PermissionError):
+            b.capture(app=app)
+        with pytest.raises(PermissionError):
+            b.focus_app(app)
+    assert b._active_pid is None and b._active_window_id is None
+    b._session.call_tool.assert_not_called()
+
+
+def test_empty_allowlist_denies_frontmost_capture():
+    b = CuaDriverBackend(allowed_apps=[])
+    b._session = Mock()
+    with pytest.raises(PermissionError):
+        b.capture()
+    b._session.call_tool.assert_not_called()
+
+
+def test_app_inventory_contains_only_assigned_browser():
+    b = CuaDriverBackend(allowed_apps=['Firefox'])
+    b._session = Mock()
+    b._session.call_tool.return_value = ok(apps=[{'name': 'Safari', 'pid': 1}, {'name': 'Firefox', 'pid': 2}])
+    assert b.list_apps() == [{'name': 'Firefox', 'pid': 2}]
+
+
+def test_exact_app_filter_rejects_similarly_named_app():
+    b = CuaDriverBackend(allowed_apps=['Firefox'])
+    b._session = Mock()
+    b._session.call_tool.return_value = ok(windows=[
+        {'app_name': 'Firefox Helper', 'pid': 1, 'window_id': 2, 'z_index': 10},
+        {'app_name': 'Firefox', 'pid': 3, 'window_id': 4, 'z_index': 1},
+    ])
+    assert b.focus_app('Firefox').ok
+    assert b._active_pid == 3 and b._active_window_id == 4
+
+
+def test_implicit_capture_uses_only_assigned_app():
+    b = CuaDriverBackend(allowed_apps=['Safari'])
+    assert b._restrict_app(None) == 'Safari'
+    assert b._restrict_app('safari') == 'safari'
+
+
+@pytest.mark.parametrize('invalid', ['Firefox', [None], [''], 1])
+def test_malformed_policy_is_not_unrestricted(invalid):
+    with pytest.raises(ValueError):
+        CuaDriverBackend(allowed_apps=invalid)
+
+
+def test_tool_factory_passes_profile_policy(monkeypatch):
+    from tools.computer_use import tool
+    import hermes_cli.config
+    tool.reset_backend_for_tests()
+    monkeypatch.setattr(hermes_cli.config, 'load_config', lambda: {'computer_use': {'allowed_apps': ['Safari']}})
+    monkeypatch.setattr(CuaDriverBackend, 'start', lambda self: None)
+    monkeypatch.setattr(CuaDriverBackend, 'stop', lambda self: None)
+    try:
+        backend = tool._get_backend()
+        assert backend._allowed_apps == ('Safari',)
+        with pytest.raises(PermissionError):
+            backend.capture(app='Firefox')
+    finally:
+        tool.reset_backend_for_tests()
