--- /dev/null
+++ b/tests/gateway/test_transcript_echo.py
@@ -0,0 +1,29 @@
+from types import SimpleNamespace
+from unittest.mock import AsyncMock,MagicMock
+import pytest
+from gateway.config import Platform
+from gateway.platforms.base import MessageType
+from gateway.run import GatewayRunner, _should_echo_transcripts
+
+@pytest.mark.parametrize('enabled',[False,True])
+@pytest.mark.asyncio
+async def test_queued_voice_keeps_transcript_without_publishing_when_disabled(monkeypatch,enabled):
+    monkeypatch.setattr('gateway.run._load_gateway_config',lambda:{'display':{'platforms':{'telegram':{'transcription_echo':enabled}}}})
+    source=SimpleNamespace(platform=Platform.TELEGRAM,chat_id='123',thread_id=None)
+    runner=object.__new__(GatewayRunner)
+    runner._enrich_message_with_transcription=AsyncMock(return_value=('recognized words',['recognized words']))
+    sender=SimpleNamespace(send=AsyncMock())
+    runner.adapters={Platform.TELEGRAM:sender}
+    adapter=MagicMock()
+    adapter.get_pending_message.return_value=SimpleNamespace(text='',media_urls=['voice.ogg'],media_types=['audio/ogg'],message_type=MessageType.VOICE)
+    result=await runner._dequeue_pending_with_transcription(adapter,'test',source)
+    assert result=='recognized words'
+    runner._enrich_message_with_transcription.assert_awaited_once_with('', ['voice.ogg'])
+    assert sender.send.await_count==(1 if enabled else 0)
+
+def test_platform_override_and_backward_compatible_default(monkeypatch):
+    source=SimpleNamespace(platform=Platform.TELEGRAM)
+    monkeypatch.setattr('gateway.run._load_gateway_config',lambda:{})
+    assert _should_echo_transcripts(source)
+    monkeypatch.setattr('gateway.run._load_gateway_config',lambda:{'display':{'transcription_echo':True,'platforms':{'telegram':{'transcription_echo':False}}}})
+    assert not _should_echo_transcripts(source)
