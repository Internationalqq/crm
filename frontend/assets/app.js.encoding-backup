    function renderExecutionSummary(stages) {
        if (!stages.length) return '';
        var today = '2026-07-25';
        var active = stages.filter(function (stage) {
            return ['started', 'in_progress'].indexOf(stage.status_code) !== -1;
        }).length;
        var done = stages.filter(function (stage) {
            return ['completed', 'approved'].indexOf(stage.status_code) !== -1 || percent(stage.progress) === 100;
        }).length;
        var blocked = stages.filter(function (stage) {
            return stage.status_code === 'blocked';
        }).length;
        var overdue = stages.filter(function (stage) {
            return isStageOverdue(stage, today);
        }).length;
        var behind = stages.filter(function (stage) {
            return isStageBehindPlan(stage, today);
        }).length;
        return '<div class="execution-summary">' +
            stat('Р В Р’В­Р РЋРІР‚С™Р В Р’В°Р В РЎвЂ”Р В РЎвЂўР В Р вЂ ', String(stages.length)) +
            stat('Р В РІР‚в„ў Р РЋР вЂљР В Р’В°Р В Р’В±Р В РЎвЂўР РЋРІР‚С™Р В Р’Вµ', String(active), active ? 'warn' : '') +
            stat('Р В РІР‚вЂќР В Р’В°Р В Р вЂ Р В Р’ВµР РЋР вЂљР РЋРІвЂљВ¬Р В Р’ВµР В Р вЂ¦Р В РЎвЂў', String(done)) +
            stat('Р В РЎСџР РЋР вЂљР В РЎвЂўР РЋР С“Р РЋР вЂљР В РЎвЂўР РЋРІР‚РЋР В Р’ВµР В Р вЂ¦Р В РЎвЂў', String(overdue), overdue ? 'danger' : '') +
            stat('Р В РЎвЂєР РЋРІР‚С™Р РЋР С“Р РЋРІР‚С™Р В Р’В°Р РЋР вЂ№Р РЋРІР‚С™', String(behind), behind ? 'warn' : '') +
            stat('Р В РІР‚ВР В Р’В»Р В РЎвЂўР В РЎвЂќР В Р’ВµР РЋР вЂљР РЋРІР‚в„–', String(blocked), blocked ? 'danger' : '') +
