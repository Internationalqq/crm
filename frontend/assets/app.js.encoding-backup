        if (size < 1024 * 1024) return Math.round(size / 1024) + ' Р В РЎв„ўР В РІР‚В';
        return (size / (1024 * 1024)).toFixed(1).replace('.0', '') + ' Р В РЎС™Р В РІР‚В';
    }

