        }
        api('/api/roles').then(function (data) {
            state.roles = Array.isArray(data.roles) ? data.roles : [];
            if (callback) callback(state.roles);
        }).catch(function () {
            state.roles = [];
            if (callback) callback(state.roles);
        });
    }

