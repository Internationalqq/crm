    function loadDashboard(callback) {
        api('/api/dashboard').then(function (data) {
            state.dashboard = data;
            callback();
        }).catch(function () {
            state.dashboard = null;
            callback();
        });
    }

    function loadRoles(callback) {
        if (state.roles.length) {
            if (callback) callback(state.roles);
